# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI ASSISTANT MODEL PROVIDER:
# Supported providers: 'gemini' (default) or 'ollama' / 'gemma' (Ollama-compatible endpoint)
LLM_PROVIDER="gemini"

# OLLAMA CONFIGURATION (optional, used when LLM_PROVIDER is set to 'ollama' or 'gemma'):
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="gemma2"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION: Required for Google OAuth authentication.
# Obtain these from your Supabase Project Settings -> API.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"
