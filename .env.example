
# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="http://localhost:3000"

# SERVER PORT: Configurable local development port (defaults to 3000)
PORT=3000

# SUPABASE CONFIGURATION: Required for Google OAuth authentication.
# Obtain these from your Supabase Project Settings -> API.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-or-publishable-key"

# OLLAMA CONFIGURATION: For SplitMate AI Assistant powered by Gemma 3 4B.
# Defaults to http://127.0.0.1:11434 and model gemma3:4b
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="gemma3:4b"
